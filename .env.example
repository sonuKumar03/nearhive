PORT=8080
DATABASE_URL=postgres://nearhive_api:nearhive-api-dev@localhost:5432/nearhive?sslmode=disable
JWT_SECRET=super-secret-jwt-key-replace-in-production

# Python Company Discovery Worker
# Use the postgres writer account for Python's DATABASE_URL.
NEARHIVE_LEASE_SECONDS=60
NEARHIVE_HEARTBEAT_INTERVAL=15.0
NEARHIVE_POLL_INTERVAL=2.0
PLAYWRIGHT_CONTEXTS=2
NEARHIVE_MAX_COMPANY_SITES=50
NEARHIVE_MAX_JOB_GEOCODES=50
NEARHIVE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
NEARHIVE_GEOCODER_PROVIDER=nominatim
